# The Prather Point Studio
#
# ONE Reserved VM deployment runs both the web app and the job worker.
# See DEPLOYMENT.md for why, and for how to split them later.
#
# NOTE: the deployment TYPE is chosen in Replit's Deployments pane, which
# writes `deploymentTarget` itself. Reserved VM is required — Autoscale can
# recycle an instance between requests, which would stall the worker.

entrypoint = "src/app/page.tsx"
modules = ["nodejs-24", "postgresql-16"]

run = "npm run dev"

[nix]
channel = "stable-24_11"

[deployment]
build = ["npm", "run", "build"]
run = ["npm", "run", "start:production"]
deploymentTarget = "vm"

[[ports]]
localPort = 3000
externalPort = 80

[env]
NODE_ENV = "production"

# The Rumble poll is the only lifecycle signal Rumble gives us, so it runs on a
# schedule rather than on demand. 60s is fine: the API is poll-only, has no
# documented rate limit, and a stream boundary within a minute is precise
# enough for a show that runs for an hour.
#
# Add these in Replit's Scheduled Deployments pane (they cannot be declared in
# .replit today):
#   every 1 minute   npm run job:rumble-poll
#   every 1 hour     npm run job:health-check
