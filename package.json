{
  "name": "prather-studio",
  "version": "0.1.0",
  "private": true,
  "description": "The Prather Point production studio \u2014 Phase 1 vertical foundation",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p ${PORT:-3000} -H 0.0.0.0",
    "worker": "tsx --tsconfig worker/tsconfig.json worker/index.ts",
    "worker:dev": "tsx watch --tsconfig worker/tsconfig.json worker/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "tsx src/db/reset.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "start:production": "node scripts/start-production.mjs",
    "db:push": "drizzle-kit push",
    "job:rumble-poll": "node scripts/enqueue-job.mjs rumble.poll_live",
    "job:health-check": "node scripts/enqueue-job.mjs integration.health_check"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "drizzle-orm": "^0.45.2",
    "next": "^16.3.4",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
