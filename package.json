{
  "name": "prather-studio",
  "version": "0.1.0",
  "private": true,
  "description": "The Prather Point production studio — Phase 1 vertical foundation",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p ${PORT:-3000} -H 0.0.0.0",
    "worker": "tsx --tsconfig worker/tsconfig.json worker/index.ts",
    "worker:dev": "tsx watch --tsconfig worker/tsconfig.json worker/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "start:production": "node scripts/start-production.mjs",
    "db:push": "drizzle-kit push",
    "job:rumble-poll": "node scripts/enqueue-job.mjs rumble.poll_live",
    "job:health-check": "node scripts/enqueue-job.mjs integration.health_check",
    "check:contrast": "node scripts/check-contrast.mjs",
    "db:seed:dev": "tsx --tsconfig worker/tsconfig.json src/db/seed.ts",
    "db:reset:dev": "tsx --tsconfig worker/tsconfig.json src/db/reset.ts",
    "db:seed": "npm run db:seed:dev",
    "db:reset": "npm run db:reset:dev",
    "job:metrics-snapshot": "node scripts/enqueue-job.mjs metrics.snapshot",
    "bootstrap:owner": "tsx --tsconfig worker/tsconfig.json src/db/bootstrap-owner.ts",
    "bootstrap:show": "tsx --tsconfig worker/tsconfig.json src/db/bootstrap-show.ts",
    "bootstrap": "npm run bootstrap:show && npm run bootstrap:owner",
    "stop": "fuser -k 3000/tcp 2>/dev/null; pkill -f \"next start\"; pkill -f \"worker/index.ts\"; sleep 2; echo stopped",
    "restart": "npm run stop; npm run start:production",
    "probe:images": "node scripts/probe-image-api.mjs",
    "probe:thumbnail": "tsx --tsconfig worker/tsconfig.json scripts/probe-thumbnail.mjs",
    "probe:sizes": "node scripts/probe-sizes.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "drizzle-orm": "^0.45.2",
    "next": "^16.3.8",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "satori": "^0.35.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
