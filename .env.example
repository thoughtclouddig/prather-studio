# ---------------------------------------------------------------------------
# The Prather Point Studio — environment
# Copy to .env for local work. On Replit these go in Secrets, never in source.
# ---------------------------------------------------------------------------

# Postgres. Replit sets this automatically when a database is attached.
DATABASE_URL=postgres://user:password@host:5432/prather_studio

# Signs and validates session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-me-with-a-long-random-string

# Seed credentials for the first OWNER account. Used by `npm run db:seed` only.
SEED_OWNER_EMAIL=andy@goshowhero.com
SEED_OWNER_PASSWORD=replace-me
SEED_EDITOR_EMAIL=editor@theprathurpoint.test
SEED_EDITOR_PASSWORD=replace-me

# Optional
PORT=3000
WORKER_ID=worker-1
WORKER_POLL_MS=2000
DB_POOL_MAX=10

# ---------------------------------------------------------------------------
# NOT USED IN PHASE 1 — no provider integrations exist yet. Listed so the shape
# is known, and so nobody adds a real key before the adapter is built.
# ---------------------------------------------------------------------------
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# BUZZSPROUT_API_TOKEN=
# MAILCHIMP_API_KEY=
# OPUSCLIP_API_KEY=
# RUMBLE_LIVESTREAM_API_URL=
# WORDPRESS_APP_PASSWORD=
