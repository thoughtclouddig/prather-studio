# ---------------------------------------------------------------------------
# The Prather Point Studio — environment
# Copy to .env for local work. On Replit these go in Secrets, never in source.
# ---------------------------------------------------------------------------

# Postgres. Replit sets this automatically when a database is attached.
DATABASE_URL=postgres://user:password@host:5432/prather_studio

# Signs and validates session cookies.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-me-with-a-long-random-string

# Encrypts every stored provider credential (AES-256-GCM). MUST be 32 bytes.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing or changing this makes existing connections undecryptable — they would
# have to be re-authorized. Back it up somewhere other than the database.
CREDENTIAL_ENCRYPTION_KEY=replace-me-32-bytes-base64

# Public origin of the app. Used to build the OAuth redirect URI.
APP_BASE_URL=http://localhost:3000

# --- YouTube -------------------------------------------------------------
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# → "Web application". Enable "YouTube Data API v3" and "YouTube Analytics API".
# Authorized redirect URI must be exactly:
#   <APP_BASE_URL>/api/integrations/youtube/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Only needed if the redirect URI differs from the default above.
# YOUTUBE_REDIRECT_URI=

# --- Claude --------------------------------------------------------------
# Powers `episode.package`. Without it the content engine cannot run.
ANTHROPIC_API_KEY=

# --- Rumble --------------------------------------------------------------
# NOT an env var. The Live Stream API URL is entered in the Studio
# (Integrations → Rumble) and stored encrypted, because the URL is the secret.
# Generate it at https://rumble.com/account/livestream-api

# Seed credentials for the first OWNER account. Used by `npm run db:seed` only.
SEED_OWNER_EMAIL=andy@goshowhero.com
SEED_OWNER_PASSWORD=replace-me
SEED_EDITOR_EMAIL=editor@theprathurpoint.test
SEED_EDITOR_PASSWORD=replace-me

# Optional
PORT=3000
WORKER_ID=worker-1
WORKER_POLL_MS=2000
DB_POOL_MAX=10

# ---------------------------------------------------------------------------
# NOT USED YET — no adapter exists for these. Listed so the shape is known.
# ---------------------------------------------------------------------------
# BUZZSPROUT_API_TOKEN=
# MAILCHIMP_API_KEY=
# OPUSCLIP_API_KEY=
# WORDPRESS_APP_PASSWORD=
